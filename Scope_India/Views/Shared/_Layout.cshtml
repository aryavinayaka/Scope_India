<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Scope India</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/Scope_India.styles.css" asp-append-version="true" />

    <style>
            html {
                scroll-behavior: smooth;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar" style="background:transparent;">
            <div class="container-fluid d-flex justify-content-between align-items-center py-2">
                <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center text-decoration-none">
                    <img src="~/images/logo.png" alt="Scope India" style="height:50px;" />
                </a>

                <button class="btn" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation"
                        style="border: none; background: transparent;">
                    <i class="bi bi-list text-white" style="font-size: 2rem;"></i>
                </button>
            </div>

            <div class="collapse" id="mainNavbar">
                <div class="container-fluid pb-3">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/#home">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/#courses">Courses</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/#about">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/#testimonials">Testimonials</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/#careers">Careers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/#contact">Contact Us</a>
                        </li>
                        <li class="nav-item mt-2">
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Profile">Hi, @User.Identity.Name</a>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link text-white p-0" style="border:none;">Logout</button>
                                </form>
                            }
                            else
                            {
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
                                <a class="nav-link" style="color:#d4a017;" asp-controller="Account" asp-action="Register">Register</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @RenderBody()

    <footer class="py-4" style="background-color:#0f2549; color:white;">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gy-3">
            <div class="fw-bold">SCOPE INDIA</div>
            <ul class="nav">
                <li class="nav-item"><a class="nav-link text-white-50" href="#home">Home</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" href="#about">About</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" href="#courses">Courses</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" href="#placements">Placements</a></li>
                <li class="nav-item"><a class="nav-link text-white-50" href="#contact">Contact</a></li>
            </ul>
            <div>
                <i class="bi bi-linkedin me-2"></i>
                <i class="bi bi-instagram me-2"></i>
                <i class="bi bi-youtube"></i>
            </div>
        </div>
        <div class="text-center text-white-50 small mt-3">&copy; 2026 SCOPE INDIA. All Rights Reserved.</div>
    </footer>

    <!-- Chatbot Widget -->
    <div id="chatbot-widget">
        <div id="chatbot-toggle" onclick="toggleChat()">💬</div>
        <div id="chatbot-box" style="display:none;">
            <div id="chatbot-header">Scope India Assistant</div>
            <div id="chatbot-messages"></div>
            <div id="chatbot-input-row">
                <input type="text" id="chatbot-input" placeholder="Ask a question..." onkeypress="if(event.key==='Enter') sendMessage()" />
                <button onclick="sendMessage()">Send</button>
            </div>
        </div>
    </div>

    <style>
            #chatbot-widget {
                position: fixed;
                bottom: 20px;
                right: 20px;
                z-index: 1000;
                font-family: inherit;
            }

            #chatbot-toggle {
                background: #1a3d7c;
                color: #d4a017;
                width: 55px;
                height: 55px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                font-size: 26px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.3);
            }

            #chatbot-box {
                width: 300px;
                height: 400px;
                background: white;
                border: 1px solid #ccc;
                border-radius: 10px;
                position: absolute;
                bottom: 65px;
                right: 0;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                box-shadow: 0 4px 16px rgba(0,0,0,0.25);
            }

            #chatbot-header {
                background: #1a3d7c;
                color: #d4a017;
                padding: 10px;
                font-weight: bold;
                text-align: center;
            }

            #chatbot-messages {
                flex: 1;
                overflow-y: auto;
                padding: 10px;
                font-size: 14px;
            }

            #chatbot-input-row {
                display: flex;
                border-top: 1px solid #ccc;
            }

            #chatbot-input {
                flex: 1;
                border: none;
                padding: 10px;
            }

                #chatbot-input:focus {
                    outline: none;
                }

            #chatbot-input-row button {
                background: #1a3d7c;
                color: #d4a017;
                border: none;
                padding: 0 16px;
                cursor: pointer;
            }

            .chat-msg-user {
                text-align: right;
                color: #1a3d7c;
                margin: 6px 0;
            }

            .chat-msg-bot {
                text-align: left;
                color: #333;
                margin: 6px 0;
            }
    </style>

    <script>
            function toggleChat() {
                const box = document.getElementById('chatbot-box');
                box.style.display = box.style.display === 'none' ? 'flex' : 'none';
            }

            async function sendMessage() {
                const input = document.getElementById('chatbot-input');
                const message = input.value.trim();
                if (!message) return;

                const messages = document.getElementById('chatbot-messages');
                messages.innerHTML += `<div class="chat-msg-user">${message}</div>`;
                input.value = '';
                messages.scrollTop = messages.scrollHeight;

                const response = await fetch('/Chatbot/Ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });
                const data = await response.json();
                messages.innerHTML += `<div class="chat-msg-bot">${data.answer}</div>`;
                messages.scrollTop = messages.scrollHeight;
            }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>