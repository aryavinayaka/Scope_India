@model Scope_India.DAL.Course

@{
    ViewData["Title"] = Model.Name;
}

<section class="py-5" style="background-color:#1a3d7c; color:white;">
    <div class="container">
        <a href="/#courses" class="text-white-50 small">← Back to Courses</a>
        <h1 class="mt-3">@Model.Name</h1>
        <p class="lead text-white-50">@Model.Duration &nbsp;|&nbsp; ₹@Model.Fee</p>
    </div>
</section>

<section class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h4 style="color:#1a3d7c;">Course Overview</h4>
            <p class="text-muted">@Model.Description</p>

            <h5 class="mt-4" style="color:#1a3d7c;">What You'll Learn</h5>
            <ul class="text-muted">
                <li>Industry-relevant hands-on projects</li>
                <li>Mentorship from working professionals</li>
                <li>Certification upon course completion</li>
                <li>Placement assistance after graduation</li>
            </ul>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm p-4">
                <h5 style="color:#1a3d7c;">Course Details</h5>
                <p class="mb-1"><strong>Duration:</strong> @Model.Duration</p>
                <p class="mb-3"><strong>Fee:</strong> ₹@Model.Fee</p>
                <a asp-controller="Account" asp-action="Register" class="btn w-100 fw-bold" style="background-color:#d4a017; color:white;">
                    Enroll Now
                </a>
            </div>
        </div>
    </div>
</section>