@model Scope_India.ViewModels.HomePageViewModel

@{
    ViewData["Title"] = "Home Page";
}

<!-- HERO -->
<section id="home" class="position-relative" style="min-height: 90vh; overflow:hidden;">
    <img src="~/images/hero-image.jpg" alt="Scope India"
         class="position-absolute top-0 start-0 w-100 h-100"
         style="object-fit:cover; z-index:0;" />

    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background: linear-gradient(90deg, rgba(26,61,124,0.95) 0%, rgba(26,61,124,0.75) 45%, rgba(26,61,124,0.2) 100%); z-index:1;"></div>

    <div class="container position-relative d-flex align-items-center" style="min-height: 90vh; z-index:2;">
        <div class="col-lg-6 text-white py-5">
            <p class="text-uppercase small fw-bold" style="color:#d4a017; letter-spacing:2px;">— Your Career Partner</p>
            <h1 class="display-4 fw-bold">Build the Skills for a<br />Brighter <span style="color:#d4a017;">Tomorrow</span></h1>
            <p class="mt-3" style="max-width:500px;">
                Advanced training in Data Science, GenAI, Data Analytics, DevOps, Software, Networking and Cloud Computing.
            </p>
            <div class="mt-4">
                <a href="#courses" class="btn me-2 fw-bold" style="background-color:#d4a017; color:white;">Explore Courses →</a>
                <a href="#contact" class="btn btn-outline-light">Get in Touch</a>
            </div>
            <p class="small mt-4 text-white-50">Industry Expert Trainers &nbsp;|&nbsp; Hands-on Learning &nbsp;|&nbsp; 100% Placement Support</p>
        </div>
    </div>
</section>




<!-- CERTIFICATIONS -->
<section class="py-5" style="background-color:#f8f9fa;">
    <div class="container">
        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h4 style="color:#1a3d7c;">— Get Globally Certified from SCOPE INDIA</h4>
            </div>
            <div class="col-md-6">
                <p class="text-muted small mb-0">Gain in-demand skills with globally recognised certifications and take your career anywhere in the world.</p>
            </div>
        </div>
        <div class="row g-3 text-center">
            @{
                var partners = new (string Name, string FileName)[]
                {
                    ("Microsoft", "microsoft.jpeg"),
                    ("IBM", "ibm.jpeg"),
                    ("Google", "google.jpeg"),
                    ("Amazon", "amazon.jpeg"),
                    ("Red Hat", "redhat.jpeg"),
                    ("ISTQB", "istqb.jpeg"),
                    ("Cisco", "cisco.jpeg"),
                    ("GitHub", "github.jpeg")
                };
            }
            @foreach (var partner in partners)
            {
                <div class="col-6 col-md-3">
                    <div class="bg-white rounded shadow-sm d-flex align-items-center justify-content-center" style="height:100px;">
                        <img src="~/images/@partner.FileName"
                             alt="@partner.Name" style="max-height:60px; max-width:90%; object-fit:contain;" />

                    </div>
                </div>
            }
        </div>
    </div>
</section>




<!-- STATS BAR -->
<section class="py-4 border-bottom">
    <div class="container">
        <div class="row text-center">
            <div class="col-6 col-md-3 mb-3 mb-md-0">
                <i class="bi bi-mortarboard-fill fs-2" style="color:#1a3d7c;"></i>
                <h4 class="fw-bold mt-2 mb-0">18+</h4>
                <small class="text-muted">Years of Excellence</small>
            </div>
            <div class="col-6 col-md-3 mb-3 mb-md-0">
                <i class="bi bi-people-fill fs-2" style="color:#1a3d7c;"></i>
                <h4 class="fw-bold mt-2 mb-0">15,000+</h4>
                <small class="text-muted">Students Trained</small>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-briefcase-fill fs-2" style="color:#1a3d7c;"></i>
                <h4 class="fw-bold mt-2 mb-0">1,000+</h4>
                <small class="text-muted">Students Placed Every Year</small>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-globe fs-2" style="color:#1a3d7c;"></i>
                <h4 class="fw-bold mt-2 mb-0">Globally Recognised</h4>
                <small class="text-muted">Certifications</small>
            </div>
        </div>
    </div>
</section>



<!-- COURSES -->
<section id="courses" class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap">
            <div>
                <p class="text-uppercase small fw-bold mb-2" style="color:#e8622c; letter-spacing:1px;">— Our Courses</p>
                <h2 class="fw-bold mb-1" style="color:#1a1a2e;">Popular Courses</h2>
                <p class="text-muted mb-0">Choose from our industry-focused programs to build a successful career.</p>
            </div>
            <a href="#courses" class="btn btn-outline-primary rounded-pill px-3 fw-semibold" style="border-color:#1a3d7c; color:#1a3d7c;">
                View All Courses →
            </a>
        </div>

        <div class="row g-4">
            @{
                var cardStyles = new (string Bg, string IconBg, string AccentColor, string Icon)[]
                {
                    ("#eef3ff", "#4361ee", "#4361ee", "bi-calendar3"),
                    ("#fdeeea", "#e8622c", "#e8622c", "bi-infinity"),
                    ("#eafaf1", "#2ecc71", "#2ecc71", "bi-graph-up-arrow"),
                    ("#f3eefc", "#8e44ad", "#8e44ad", "bi-cloud")
                };
            }
            @if (Model.Courses != null && Model.Courses.Any())
            {
                @for (int i = 0; i < Model.Courses.Count; i++)
                {
                    var course = Model.Courses[i];
                    var style = cardStyles[i % cardStyles.Length];
                    <div class="col-md-6 col-lg-3">
                        <div class="rounded-4 p-4 h-100 position-relative" style="background-color:@style.Bg; overflow:hidden;">
                            <i class="bi @style.Icon position-absolute"
                               style="font-size:5rem; opacity:0.08; bottom:-10px; right:-10px; color:@style.AccentColor;"></i>

                            <div class="rounded-3 d-flex align-items-center justify-content-center mb-3"
                                 style="width:48px; height:48px; background-color:@style.IconBg;">
                                <i class="bi @style.Icon text-white fs-5"></i>
                            </div>

                            <h5 class="fw-bold mb-2" style="color:#1a1a2e;">@course.Name</h5>
                            <p class="text-muted small mb-4">@course.Description</p>

                            <a asp-controller="Home" asp-action="CourseDetails" asp-route-id="@course.Id"
                               class="d-flex align-items-center text-decoration-none fw-semibold position-relative"
                               style="color:@style.AccentColor; z-index:1;">
                                Explore Course
                                <span class="rounded-circle d-flex align-items-center justify-content-center ms-2"
                                      style="width:28px; height:28px; background-color:@style.AccentColor;">
                                    <i class="bi bi-arrow-right text-white small"></i>
                                </span>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No courses available at the moment.</p>
            }
        </div>
    </div>
</section>


<!-- WHY CHOOSE US -->
<section id="why-us" class="py-5" style="background-color:#1a3d7c; color:white;">
    <div class="container">
        <p class="text-uppercase small fw-bold mb-1" style="color:#d4a017;">— More Than Just a Training Institute</p>
        <h2 class="mb-4">Why Choose SCOPE INDIA?</h2>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="border rounded p-3 h-100" style="border-color:#d4a017 !important;">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:45px; height:45px; background-color:#d4a017;">
                        <i class="bi bi-laptop text-white"></i>
                    </div>
                    <h6 class="fw-bold">Classes</h6>
                    <p class="small text-white-50 mb-0">Learn Anytime, Anywhere – Online & In-person Classes Available!</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100" style="border-color:#d4a017 !important;">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:45px; height:45px; background-color:#d4a017;">
                        <i class="bi bi-rocket-takeoff text-white"></i>
                    </div>
                    <h6 class="fw-bold">Placement</h6>
                    <p class="small text-white-50 mb-0">Guaranteed Success – 100% Placement Support.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100" style="border-color:#d4a017 !important;">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:45px; height:45px; background-color:#d4a017;">
                        <i class="bi bi-people text-white"></i>
                    </div>
                    <h6 class="fw-bold">Training</h6>
                    <p class="small text-white-50 mb-0">Training by Working Professionals.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100" style="border-color:#d4a017 !important;">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:45px; height:45px; background-color:#d4a017;">
                        <i class="bi bi-file-earmark-text text-white"></i>
                    </div>
                    <h6 class="fw-bold">Internship</h6>
                    <p class="small text-white-50 mb-0">OJT (On the Job Training) after course completion with experience certificate.</p>
                </div>
            </div>
        </div>
    </div>
</section>




<!-- PLACEMENT HIGHLIGHTS -->
<section id="placements" class="py-4" style="background-color:#1a3d7c; color:white;">
    <div class="container">
        <p class="text-uppercase small fw-bold mb-3" style="color:#d4a017;">— Placement Highlights</p>
        <div class="row text-center g-3">
            <div class="col-6 col-md-3">
                <i class="bi bi-briefcase fs-3" style="color:#d4a017;"></i>
                <h5 class="fw-bold mt-2 mb-0">100%</h5>
                <small class="text-white-50">Placement Support</small>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-people fs-3" style="color:#d4a017;"></i>
                <h5 class="fw-bold mt-2 mb-0">1,000+</h5>
                <small class="text-white-50">Students Placed</small>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-bar-chart fs-3" style="color:#d4a017;"></i>
                <h5 class="fw-bold mt-2 mb-0">Top Companies</h5>
                <small class="text-white-50">Recruit Our Students</small>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-star fs-3" style="color:#d4a017;"></i>
                <h5 class="fw-bold mt-2 mb-0">Successful</h5>
                <small class="text-white-50">Career Transitions</small>
            </div>
        </div>
    </div>
</section>



<!-- TESTIMONIALS -->
<section id="testimonials" class="container py-5">
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap">
        <div>
            <p class="text-uppercase small fw-bold mb-1" style="color:#e8622c;">— Testimonials</p>
            <h2 class="fw-bold" style="color:#1a1a2e;">Success Stories That Inspire</h2>
        </div>
        <div>
            <button id="testiPrev" class="btn btn-light rounded-circle me-2" style="width:38px; height:38px;">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button id="testiNext" class="btn btn-light rounded-circle" style="width:38px; height:38px;">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>

    @if (Model.Testimonials != null && Model.Testimonials.Any())
    {
        <div class="row g-3 align-items-stretch">
            <div class="col-lg-6">
                <div id="testiList" class="d-flex flex-column justify-content-between h-100"></div>
            </div>

            <div class="col-lg-6">
                <div class="rounded-4 p-3 h-100" style="background:#eef3ff;">
                    <div id="testiFeatured"></div>
                </div>
            </div>
        </div>
    }
</section>

<script>
    const testimonials = [
        @foreach (var t in Model.Testimonials)
        {
                @:{ name: "@t.StudentName", role: "@t.Role", company: "@t.Company", course: "@t.CourseTaken", message: "@Html.Raw(t.Message.Replace("\"", "\\\""))", photo: "@t.PhotoPath", rating: @t.Rating },
        }
    ];

    let currentTesti = 0;

    function renderList(startIndex) {
        const listContainer = document.getElementById('testiList');
        listContainer.innerHTML = '';

        for (let i = 0; i < 2; i++) {
            const idx = (startIndex + i) % testimonials.length;
            const t = testimonials[idx];
            const stars = '★'.repeat(t.rating) + '☆'.repeat(5 - t.rating);

            const item = document.createElement('div');
            item.className = 'testi-item bg-white rounded-3 shadow-sm p-3 mb-2 d-flex';
            item.style.cursor = 'pointer';
            item.dataset.index = idx;
            item.innerHTML = `
                <i class="bi bi-quote fs-5 me-2" style="color:#4361ee;"></i>
                <div class="flex-grow-1">
                    <p class="mb-1 small">${t.message}</p>
                    <div class="text-warning small mb-1">${stars}</div>
                    <h6 class="fw-bold mb-0 small">${t.name}</h6>
                    <small class="text-muted" style="font-size:0.75rem;">${t.course}${t.company ? ' · ' + t.company : ''}</small>
                </div>
            `;
            item.addEventListener('click', () => {
                currentTesti = idx;
                renderFeatured(currentTesti);
                renderList(currentTesti);
            });
            listContainer.appendChild(item);
        }
    }

    function renderFeatured(index) {
        const t = testimonials[index];
        const container = document.getElementById('testiFeatured');
        container.innerHTML = `
            <h5 class="fw-bold mb-2" style="color:#1a1a2e;">${t.name}</h5>
            <div style="width:32px; height:2px; background:#4361ee; margin-bottom:10px;"></div>
            <img src="${t.photo || '/images/testimonials/default.jpg'}" alt="${t.name}"
                 class="rounded-3 mb-2" style="width:100%; max-width:140px; height:140px; object-fit:cover;" />
            <div class="d-flex align-items-center mb-2">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-2"
                     style="width:28px; height:28px; background:white;">
                    <i class="bi bi-briefcase small" style="color:#4361ee;"></i>
                </div>
                <div>
                    <div class="fw-bold small">${t.role || ''}</div>
                    <small class="text-muted" style="font-size:0.75rem;">${t.company || ''}</small>
                </div>
            </div>
            <i class="bi bi-quote fs-5" style="color:#4361ee;"></i>
            <p class="mt-1 small mb-0">${t.message}</p>
        `;
    }

    document.getElementById('testiPrev').addEventListener('click', () => {
        currentTesti = (currentTesti - 1 + testimonials.length) % testimonials.length;
        renderFeatured(currentTesti);
        renderList(currentTesti);
    });

    document.getElementById('testiNext').addEventListener('click', () => {
        currentTesti = (currentTesti + 1) % testimonials.length;
        renderFeatured(currentTesti);
        renderList(currentTesti);
    });

    if (testimonials.length > 0) {
        renderFeatured(0);
        renderList(0);
    }
</script>


