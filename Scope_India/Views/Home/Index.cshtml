@model Scope_India.ViewModels.HomePageViewModel

@{
    ViewData["Title"] = "Home Page";
}

<!-- HERO -->
<section id="home" class="position-relative" style="min-height: 90vh; overflow:hidden;">
    <img src="~/images/hero image.jpg.jpeg" alt="Scope India"
         class="position-absolute top-0 start-0 w-100 h-100"
         style="object-fit:cover; z-index:0;" />

    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background: linear-gradient(90deg, rgba(26,61,124,0.95) 0%, rgba(26,61,124,0.75) 45%, rgba(26,61,124,0.2) 100%); z-index:1;"></div>

    <div class="container position-relative d-flex align-items-center" style="min-height: 90vh; z-index:2;">
        <div class="col-lg-6 text-white py-5">
            <p class="text-uppercase small fw-bold" style="color:#d4a017; letter-spacing:2px;">— Your Career Partner</p>
            <h1 class="display-4 fw-bold">Build the Skills for a<br />Brighter <span style="color:#d4a017;">Tomorrow</span></h1>
            <p class="mt-3" style="max-width:500px;">
                Advanced training in Data Science, GenAI, Data Analytics, DevOps, Software, Networking and Cloud Computing.
            </p>
            <div class="mt-4">
                <a href="#courses" class="btn me-2 fw-bold" style="background-color:#d4a017; color:white;">Explore Courses →</a>
                <a href="#contact" class="btn btn-outline-light">Get in Touch</a>
            </div>
            <p class="small mt-4 text-white-50">Industry Expert Trainers &nbsp;|&nbsp; Hands-on Learning &nbsp;|&nbsp; 100% Placement Support</p>
        </div>
    </div>
</section>

<!-- STATS BAR -->
<section class="py-4 border-bottom">
    <div class="container">
        <div class="row text-center">
            <div class="col-6 col-md-3 mb-3 mb-md-0">
                <i class="bi bi-mortarboard-fill fs-2" style="color:#1a3d7c;"></i>
                <h4 class="fw-bold mt-2 mb-0">18+</h4>
                <small class="text-muted">Years of Excellence</small>
            </div>
            <div class="col-6 col-md-3 mb-3 mb-md-0">
                <i class="bi bi-people-fill fs-2" style="color:#1a3d7c;"></i>
                <h4 class="fw-bold mt-2 mb-0">15,000+</h4>
                <small class="text-muted">Students Trained</small>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-briefcase-fill fs-2" style="color:#1a3d7c;"></i>
                <h4 class="fw-bold mt-2 mb-0">1,000+</h4>
                <small class="text-muted">Students Placed Every Year</small>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-globe fs-2" style="color:#1a3d7c;"></i>
                <h4 class="fw-bold mt-2 mb-0">Globally Recognised</h4>
                <small class="text-muted">Certifications</small>
            </div>
        </div>
    </div>
</section>

<!-- COURSES -->
<section id="courses" class="py-5" style="background-color:#f8f9fa;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap">
            <div>
                <p class="text-uppercase small fw-bold mb-1" style="color:#d4a017;">— Our Courses</p>
                <h2 style="color:#1a3d7c;">Industry-Relevant Courses for a Better Tomorrow</h2>
            </div>
            <a href="#courses" class="fw-bold text-decoration-none" style="color:#1a3d7c;">View All Courses →</a>
        </div>

        <div class="row g-3">
            @{
                var icons = new[] { "bi-cpu", "bi-code-slash", "bi-graph-up-arrow", "bi-clipboard-check", "bi-bar-chart-line", "bi-hdd-stack", "bi-infinity", "bi-cloud", "bi-diagram-3", "bi-phone", "bi-megaphone", "bi-pencil-square" };
            }
            @if (Model.Courses != null && Model.Courses.Any())
            {
                @for (int i = 0; i < Model.Courses.Count; i++)
                {
                    var course = Model.Courses[i];
                    var icon = icons[i % icons.Length];
                    <div class="col-6 col-md-4 col-lg-2">
                        <div class="bg-white rounded p-3 h-100 shadow-sm text-center">
                            <i class="bi @icon fs-3" style="color:#1a3d7c;"></i>
                            <p class="fw-bold small mt-2 mb-2">@course.Name</p>
                            <a href="#" class="d-inline-block rounded-circle" style="width:28px; height:28px; background-color:#f0f0f0; line-height:28px;">
                                <i class="bi bi-arrow-right small" style="color:#1a3d7c;"></i>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No courses available at the moment.</p>
            }
        </div>
    </div>
</section>

<!-- WHY CHOOSE US -->
<section id="why-us" class="py-5" style="background-color:#1a3d7c; color:white;">
    <div class="container">
        <p class="text-uppercase small fw-bold mb-1" style="color:#d4a017;">— More Than Just a Training Institute</p>
        <h2 class="mb-4">Why Choose SCOPE INDIA?</h2>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="border rounded p-3 h-100" style="border-color:#d4a017 !important;">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:45px; height:45px; background-color:#d4a017;">
                        <i class="bi bi-laptop text-white"></i>
                    </div>
                    <h6 class="fw-bold">Classes</h6>
                    <p class="small text-white-50 mb-0">Learn Anytime, Anywhere – Online & In-person Classes Available!</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100" style="border-color:#d4a017 !important;">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:45px; height:45px; background-color:#d4a017;">
                        <i class="bi bi-rocket-takeoff text-white"></i>
                    </div>
                    <h6 class="fw-bold">Placement</h6>
                    <p class="small text-white-50 mb-0">Guaranteed Success – 100% Placement Support.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100" style="border-color:#d4a017 !important;">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:45px; height:45px; background-color:#d4a017;">
                        <i class="bi bi-people text-white"></i>
                    </div>
                    <h6 class="fw-bold">Training</h6>
                    <p class="small text-white-50 mb-0">Training by Working Professionals.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100" style="border-color:#d4a017 !important;">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:45px; height:45px; background-color:#d4a017;">
                        <i class="bi bi-file-earmark-text text-white"></i>
                    </div>
                    <h6 class="fw-bold">Internship</h6>
                    <p class="small text-white-50 mb-0">OJT (On the Job Training) after course completion with experience certificate.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MISSION / VISION (ABOUT) -->
<section id="about" class="container py-5">
    <div class="row g-5">
        <div class="col-md-6">
            <i class="bi bi-bullseye fs-2" style="color:#1a3d7c;"></i>
            <h5 class="fw-bold mt-2" style="color:#1a3d7c;">Our Mission</h5>
            <p class="text-muted">
                SCOPE INDIA seeks to close the knowledge gap between education and employment by offering
                interactive, industry-focused IT training led by proficient working professionals aligned
                with the latest trends and technologies.
            </p>
            <ul class="list-unstyled">
                <li class="mb-1"><i class="bi bi-check-lg" style="color:#d4a017;"></i> Industry-aligned curriculum</li>
                <li class="mb-1"><i class="bi bi-check-lg" style="color:#d4a017;"></i> Practical skill development</li>
                <li class="mb-1"><i class="bi bi-check-lg" style="color:#d4a017;"></i> Career-focused training</li>
            </ul>
        </div>
        <div class="col-md-6">
            <i class="bi bi-eye fs-2" style="color:#1a3d7c;"></i>
            <h5 class="fw-bold mt-2" style="color:#1a3d7c;">Our Vision</h5>
            <p class="text-muted">
                We aspire to become the most respected and forward-thinking training organization in India
                and beyond by shaping the future of IT education via innovation, integrity, and strong industry ties.
            </p>
            <ul class="list-unstyled">
                <li class="mb-1"><i class="bi bi-check-lg" style="color:#d4a017;"></i> Global recognition</li>
                <li class="mb-1"><i class="bi bi-check-lg" style="color:#d4a017;"></i> Innovation leadership</li>
                <li class="mb-1"><i class="bi bi-check-lg" style="color:#d4a017;"></i> Technology excellence</li>
            </ul>
        </div>
    </div>
</section>

<!-- CERTIFICATIONS -->
<section class="py-5" style="background-color:#f8f9fa;">
    <div class="container">
        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h4 style="color:#1a3d7c;">— Get Globally Certified from SCOPE INDIA</h4>
            </div>
            <div class="col-md-6">
                <p class="text-muted small mb-0">Gain in-demand skills with globally recognised certifications and take your career anywhere in the world.</p>
            </div>
        </div>
        <div class="row g-3 text-center">
            @foreach (var partner in new[] { "Microsoft", "IBM", "Google", "Amazon", "Red Hat", "ISTQB", "Cisco", "GitHub" })
            {
                <div class="col-6 col-md-3">
                    <div class="bg-white rounded p-3 shadow-sm fw-bold" style="color:#333;">@partner</div>
                </div>
            }
        </div>
    </div>
</section>

<!-- PLACEMENT HIGHLIGHTS -->
<section id="placements" class="py-4" style="background-color:#1a3d7c; color:white;">
    <div class="container">
        <p class="text-uppercase small fw-bold mb-3" style="color:#d4a017;">— Placement Highlights</p>
        <div class="row text-center g-3">
            <div class="col-6 col-md-3">
                <i class="bi bi-briefcase fs-3" style="color:#d4a017;"></i>
                <h5 class="fw-bold mt-2 mb-0">100%</h5>
                <small class="text-white-50">Placement Support</small>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-people fs-3" style="color:#d4a017;"></i>
                <h5 class="fw-bold mt-2 mb-0">1,000+</h5>
                <small class="text-white-50">Students Placed</small>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-bar-chart fs-3" style="color:#d4a017;"></i>
                <h5 class="fw-bold mt-2 mb-0">Top Companies</h5>
                <small class="text-white-50">Recruit Our Students</small>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-star fs-3" style="color:#d4a017;"></i>
                <h5 class="fw-bold mt-2 mb-0">Successful</h5>
                <small class="text-white-50">Career Transitions</small>
            </div>
        </div>
    </div>
</section>

<!-- TESTIMONIALS -->
<section id="testimonials" class="container py-5">
    <p class="text-uppercase small fw-bold mb-1" style="color:#d4a017;">— Testimonials</p>
    <h2 class="mb-4" style="color:#1a3d7c;">Success Stories That Inspire</h2>

    @if (Model.Testimonials != null && Model.Testimonials.Any())
    {
        <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                @for (int i = 0; i < Model.Testimonials.Count; i++)
                {
                    var t = Model.Testimonials[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="bg-white rounded shadow-sm p-4 mx-auto" style="max-width:700px;">
                            <i class="bi bi-quote fs-2" style="color:#d4a017;"></i>
                            <p class="fst-italic">@t.Message</p>
                            <div class="d-flex align-items-center mt-3">
                                <div class="rounded-circle bg-light me-3" style="width:45px; height:45px;"></div>
                                <div>
                                    <h6 class="fw-bold mb-0">@t.StudentName</h6>
                                    <small class="text-muted">@t.CourseTaken</small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev" style="width:5%;">
                <span class="carousel-control-prev-icon" style="filter:invert(1) grayscale(100%) brightness(0.3);"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next" style="width:5%;">
                <span class="carousel-control-next-icon" style="filter:invert(1) grayscale(100%) brightness(0.3);"></span>
            </button>
        </div>
    }
</section>

<!-- CTA -->
<section id="contact" class="py-5" style="background-color:#1a3d7c; color:white;">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gy-3">
        <div>
            <h3 class="mb-1">Ready to Start Your Journey?</h3>
            <p class="text-white-50 mb-0">Take the first step towards a successful career with SCOPE INDIA.</p>
        </div>
        <a asp-controller="Account" asp-action="Register" class="btn fw-bold" style="background-color:#d4a017; color:white;">Get Started →</a>
    </div>
</section>